#!/bin/bash

# Ustawienie nazw plików
INPUT_FILE="dane_logi.log"       # Podmień na nazwę swojego pliku 30 GB
OUTPUT_FILE="wyekstrahowane.log"

# Zakres dat i szukany realm
START="2026-10-05T09:14:33"
END="2026-10-05T11:48:27"
REALM='realm="eqn-saf"'

echo "Rozpoczynam przetwarzanie 30 GB logów..."

# Optymalizacja LC_ALL=C + filtrowanie grep -> awk
LC_ALL=C grep "$REALM" "$INPUT_FILE" | \
LC_ALL=C awk -F'at="' -v start="$START" -v end="$END" '$2 >= start && $2 <= end' > "$OUTPUT_FILE"

echo "Gotowe! Wyniki zapisano w: $OUTPUT_FILE"
